# seekdb 连接配置（复制为 .env 或在启动前 export）
# 方式一：server 模式（推荐，docker-compose.yml 已提供）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=kb

# 方式二：嵌入式模式（SEEKDB_PATH 指向数据目录，Linux/macOS 推荐）
# SEEKDB_PATH=./seekdb-embedded

# 应用端口
PORT=8787

# 模型下载镜像（仅 scripts/fetch-models.mjs 使用，可选）
# HF_ENDPOINT=https://hf-mirror.com
