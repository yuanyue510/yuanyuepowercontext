# ---- seekdb / OceanBase（MySQL 协议）----
SDD_DB_HOST=127.0.0.1
SDD_DB_PORT=2881
SDD_DB_USER=root
SDD_DB_PASSWORD=
SDD_DB_NAME=sdd_context

# ---- 向量化后端：hash（默认，无需外部服务）/ minimax ----
SDD_EMBED_PROVIDER=hash
SDD_EMBED_DIM=1024

# ---- MiniMax（代码修改必需）----
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_MODEL=MiniMax-M2
MINIMAX_GROUP_ID=
# auto | chatcompletion_v2 | openai
MINIMAX_API_STYLE=auto

# ---- PowerContext（任务状态）----
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_SCOPE_ID=
POWERCONTEXT_TOKEN=

# ---- 运行记录目录 ----
SDD_RECORDS_DIR=records
